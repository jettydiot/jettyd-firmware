menu "jettyd configuration"

    config JETTYD_FLEET_TOKEN
        string "Fleet token"
        default ""
        help
            Fleet token from api.jettyd.com/v1/fleet-tokens.
            Used on first boot to provision the device.
            After provisioning this is replaced by a per-device key.

    config JETTYD_MQTT_URI
        string "MQTT broker URI"
        default "mqtt://mqtt.jettyd.com:1883"
        help
            URI of the jettyd MQTT broker.

    config JETTYD_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            Your WiFi network name.

    config JETTYD_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            Your WiFi password. Leave empty for open networks.

    config JETTYD_FIRMWARE_VERSION
        string "Firmware version"
        default "0.1.0"
        help
            Firmware version string reported to the platform.

    config JETTYD_DEVICE_TYPE
        string "Device type slug"
        default "esp32-generic"
        help
            Device type slug from api.jettyd.com/v1/device-types.
            Used during provisioning to identify the hardware.

    config JETTYD_WIFI_SET_TIMEOUT_MS
        int "wifi.set reconnect timeout (ms)"
        default 30000
        range 5000 120000
        help
            How long the `wifi.set` device command waits for the new network to
            reach a connected state before rolling back to the previous WiFi
            credentials and reporting failure.

    config JETTYD_DISPLAY_PIN_DIN
        int "Display DIN pin (GPIO)"
        default 10
        help
            GPIO pin connected to the MAX7219 DIN (data in) line.

    config JETTYD_DISPLAY_PIN_CLK
        int "Display CLK pin (GPIO)"
        default 8
        help
            GPIO pin connected to the MAX7219 CLK line.

    config JETTYD_DISPLAY_PIN_CS
        int "Display CS/LOAD pin (GPIO)"
        default 9
        help
            GPIO pin connected to the MAX7219 CS (LOAD) line.
            Note: the FC16 reference wiring diagram shows GPIO20 but the
            reference sketch code uses GPIO9 — default is 9, reconfigure as needed.

    config JETTYD_DISPLAY_MODULES
        int "Number of daisy-chained MAX7219 modules"
        default 4
        range 1 4
        help
            Number of MAX7219 modules in the daisy chain. Each module adds 8 columns.
            The display driver supports up to 4 modules (32x8 pixels).

    config JETTYD_DISPLAY_BRIGHTNESS
        int "Default display brightness (0-15)"
        default 3
        range 0 15
        help
            Initial MAX7219 intensity register value, 0 = minimum, 15 = maximum.

endmenu
